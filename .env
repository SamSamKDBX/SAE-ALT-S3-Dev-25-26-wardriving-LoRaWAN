# Configuration LoRaWAN Wardriving
# Modifier ces valeurs selon votre installation

# Adresse du broker MQTT ChirpStack
MQTT_BROKER=chirpstack.iut-blagnac.fr

# Port MQTT (8883 pour TLS, 1883 sans TLS)
MQTT_PORT=8883

# APP_ID
APP_ID=6

# LoRaWAN (format hex sans 0x, séparateurs acceptés)
LORAWAN_DEVEUI=0C7E450102030106
LORAWAN_APPKEY=0102030405060708090A0B0C0D0E0106

# topic MQTT (Par défaut : application/{APP_ID}/device/{DEVEUI}/event/up)
MQTT_TOPIC=application/+/device/+/event/up
