# ============================================================
# Configuration LoRaWAN Wardriving
# Modifier ces valeurs selon votre installation
# ============================================================

# --- Connexion MQTT ---
MQTT_BROKER=chirpstack.iut-blagnac.fr
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=true

# --- Identification du device ---
# Prefixe DevEUI de votre organisation (14 caracteres hexa)
# ex : 0c7e4501020301
DEVEUI=0c7e450102030106

# --- Topic MQTT ---
# Numero d'application ChirpStack
CHIRPSTACK_APP_ID=6

# Format du topic (utilise {app_id} et {deveui} comme placeholders)
# ChirpStack v4 : application/{app_id}/device/{deveui}/event/up
# ChirpStack v3 : application/{app_id}/device/{deveui}/rx
# TTN : v3/{app_id}/devices/{deveui}/up
#MQTT_TOPIC=application/{app_id}/device/{deveui}/event/up
